{
  "compileOnSave": false,
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "strict": false,
    "noUnusedParameters": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "esModuleInterop": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "paths": {
      "*": ["./*"],
      "@components": [
        "./src/app/components"
      ],
      "@services": [
        "./src/app/services"
      ],
      "@pipes": [
        "./src/app/pipes"
      ],
      "@models": [
        "./src/app/models"
      ],
      "@directives": [
        "./src/app/directives"
      ],
      "@store": [
        "./src/app/store"
      ],
      "@shared": [
        "./src/app/shared"
      ],
      "@environments": [
        "./src/environments"
      ],
      "@testing": [
        "./src/app/testing"
      ],
      "@components/*": [
        "./src/app/components/*"
      ],
      "@services/*": [
        "./src/app/services/*"
      ],
      "@pipes/*": [
        "./src/app/pipes/*"
      ],
      "@models/*": [
        "./src/app/models/*"
      ],
      "@directives/*": [
        "./src/app/directives/*"
      ],
      "@store/*": [
        "./src/app/store/*"
      ],
      "@shared/*": [
        "./src/app/shared/*"
      ],
      "@environments/*": [
        "./src/environments/*"
      ],
      "@testing/*": [
        "./src/app/testing/*"
      ],
      "@i18n/*": [
        "./src/assets/i18n/*"
      ]
    }
  }
}
